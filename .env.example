# Copy to .env and adjust. Vite only exposes vars prefixed with VITE_.

# Master switch for CRM-mutating actions (gate scan, supervisor action, classify).
# false (or unset) = read-only: the UI works but no writes are sent.
# true = live writes against the configured backend. Rebuild after changing.
VITE_WRITE_ACTIONS=false

# Dev-only: backend the Vite dev server proxies /api to.
# VITE_API_PROXY=http://127.0.0.1:8001
